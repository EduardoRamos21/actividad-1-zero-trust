# ============================================================================
# Variables de Entorno - Backend Zero Trust
# ============================================================================
# Copia este archivo como .env y reemplaza los valores
# NUNCA subas el archivo .env real al repositorio
# ============================================================================

# Puerto del servidor
PORT=3000

# JWT - Secreto para firmar tokens (CAMBIAR en producción)
# Generar uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# En producción el proceso no arranca si el secreto contiene CAMBIAR o CAMBIA_.
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_64_BYTES
JWT_EXPIRES_IN=1h

# Usuarios de práctica (src/services/authService.js), solo para la actividad:
#   admin    / Admin123!
#   auditor  / Auditor123!

# CORS - Orígenes permitidos (IP Elástica o dominio del Frontend)
# Actualizar con tu Elastic IP o dominio real después de desplegar Terraform
CORS_ORIGIN=https://tu-dominio.com

# Entorno
NODE_ENV=production
